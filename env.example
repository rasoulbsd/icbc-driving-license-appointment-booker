# =============================================================================
# Backend Configuration
# =============================================================================
PORT=3000
NODE_ENV=production  # 'development' to show stack traces in API errors; 'test' to skip server listen

EXAM_TYPE=7-R-1  # e.g. 5-R-1, 7-R-1
LAST_NAME=
BCID_NUMBER=111556588
LICENSE_NUMBER=  # Optional; falls back to BCID_NUMBER if set
ICBC_DATE=14 March 2024
APPOINTMENT_SEARCH_DAYS=14
ICBC_KEYWORD=2336lili
ICBC_COOKIES=TS018e4505=...; TS3c41ca9e027=...; JSESSIONID=...

# Playwright (token renewal / login crawl)
PLAYWRIGHT_HEADLESS=false  # 'false' = GUI visible; 'true' = headless
CHROMIUM_PATH=  # Optional; e.g. /usr/bin/chromium-browser (set automatically in Docker when IN_DOCKER=true)
IN_DOCKER=false  # Set to 'true' by docker-compose for backend; enables Docker-specific Chromium path

# =============================================================================
# Bot Configuration
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-1000000000000
TELEGRAM_CHANNEL_ID_ALL=-1000000000000  # Optional: channel for ALL locations search
ENABLE_ALL_LOCATIONS_SEARCH=true  # 'false' to disable ALL locations (default: true if TELEGRAM_CHANNEL_ID_ALL set)

# Bot mode: 'dev' or 'prod' (default: prod)
BOT_MODE=prod

# Docker detection (bot only) – isDocker is derived from these; no separate IS_DOCKER var
# Set automatically by docker-compose for the bot service. If bot runs on host, leave unset.
DOCKER_ENV=  # Set to 'true' in Docker so bot uses backend hostname
IN_DOCKER=   # Set to 'true' in Docker (same effect as DOCKER_ENV)

# API URLs – mode-specific (recommended)
# When BOT_MODE=dev and DOCKER_ENV/IN_DOCKER not set, bot uses localhost; in Docker it uses host "backend".
# When BOT_MODE=prod in Docker, set PROD_API_URL so bot always hits backend (avoids legacy API_URL override).

# Development (used when BOT_MODE=dev)
DEV_API_URL=http://localhost:3000/appointments
# DEV_API_URL_ALL=http://localhost:3000/appointments-all
# DEV_API_URL_SEARCH=http://localhost:3000/appointments/search
# DEV_BACKEND_HOST=localhost  # or 'backend' when bot in Docker
# DEV_BACKEND_PORT=3000

# Production (used when BOT_MODE=prod). In Docker, use backend service name.
PROD_API_URL=http://backend:3000/appointments
# PROD_API_URL_ALL=http://backend:3000/appointments-all
# PROD_API_URL_SEARCH=http://backend:3000/appointments/search
# PROD_BACKEND_HOST=backend  # or 127.0.0.1 if bot on host, backend in Docker
# PROD_BACKEND_PORT=3000

# Legacy – only used if DEV_API_URL and PROD_API_URL are both unset. Avoid in Docker; can override to localhost and cause IPv6 issues.
# API_URL=http://localhost:3000/appointments
# API_URL_ALL=...
# API_URL_SEARCH=...

# Optional backend host/port when not using full API URLs
# BACKEND_HOST=backend
# BACKEND_PORT=3000

LOCATION_SEARCH=north vancouver
USE_PLAYWRIGHT_API=true  # 'true' = Playwright-based API; 'false' = traditional API
DEBUG_MODE=false
UPDATE_INTERVALS=1,1.25,1.5,1.75,2

# Optional: send to API with requests (if not using .env on backend)
# BEARER_TOKEN=
# EXAM_TYPE= , LAST_NAME= , LICENSE_NUMBER= / BCID_NUMBER=  (see backend section)